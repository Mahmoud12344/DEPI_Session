@model List<depiSession.Models.Product>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Product List</h2>
        <a asp-action="Add" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Product
        </a>
    </div>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Category</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
        </thead>
        <tbody>
        @foreach(var p in Model)
        {
            <tr>
                <td class="align-middle">@p.Id</td>
                <td class="align-middle">@p.Name</td>
                <td class="align-middle">@p.Description</td>
                <td class="align-middle">@p.Price</td>
                <td class="align-middle">@p.Category?.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Edit</a>

                </td>  
                    <td>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" 
                              onsubmit="return confirm('Are you sure you want to delete @p.Name?');" 
                              style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                    
              
            </tr>
        }
        </tbody>
    </table>
</div>

